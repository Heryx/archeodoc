# ─── Provider AI ──────────────────────────────────────────────────────────────
# Seleziona quale provider usare: "gemini" (default), "openai" o "claude"
# Se non specificato, viene usato automaticamente il provider per cui hai una chiave.
# Priorità auto-detect: Gemini → OpenAI → Claude
# AI_PROVIDER=gemini

# ─── Google Gemini (GRATUITO) ─────────────────────────────────────────────────
# Ottieni la tua chiave gratuita su https://aistudio.google.com/
# Modello usato: gemini-1.5-flash
GEMINI_API_KEY=metti-qui-la-tua-chiave-gemini

# ─── Anthropic Claude (a pagamento, opzionale) ────────────────────────────────
# Ottieni la tua chiave su https://console.anthropic.com
# Modello usato: claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-metti-qui-la-tua-chiave

# ─── OpenAI (a pagamento, opzionale) ──────────────────────────────────────────
# Ottieni la tua chiave su https://platform.openai.com/api-keys
# Modello default: gpt-4o-mini (economico e veloce)
# OPENAI_API_KEY=sk-metti-qui-la-tua-chiave
# OPENAI_MODEL=gpt-4o-mini

# ─── Porta del server (default: 5000) ─────────────────────────────────────────
# PORT=5000
